# Copy this file to .env and fill in real values before running in production.

APP_NAME=FlowMind AI
ENV=development

# Auth - generate a real secret with: openssl rand -hex 32
SECRET_KEY=change-this-secret-key-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database (SQLite by default; swap for Postgres in production)
DATABASE_URL=sqlite:///./flowmind.db
# DATABASE_URL=postgresql://flowmind:flowmind@db:5432/flowmind

# AI providers - Claude is primary, Gemini is the automatic fallback.
# The app runs fine with only one of these set, or neither (extractive mode).
AI_PROVIDER=claude
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-4-6
# Get a Gemini key free at https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Google Sign-In (OAuth) - create an OAuth Client ID at
# https://console.cloud.google.com/apis/credentials (type: Web application)
GOOGLE_CLIENT_ID=

# Vector store
CHROMA_PERSIST_DIR=./chroma_data
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Reliability / performance - optional, app falls back gracefully without it
REDIS_URL=
RATE_LIMIT_CHAT=20/minute
RATE_LIMIT_WORKFLOW_RUN=30/minute
CACHE_TTL_SECONDS=300

# Outbound email for the send_email workflow action (optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# CORS
ALLOWED_ORIGINS=http://localhost:3000

# Billing (optional) - Stripe Checkout for workspace upgrades
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID_PRO=
FRONTEND_URL=http://localhost:3000

# Integrations (all optional - workflow nodes log instead of failing if unset)
SLACK_DEFAULT_WEBHOOK_URL=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
GOOGLE_SERVICE_ACCOUNT_JSON=
